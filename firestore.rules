rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CyberShield Validation Helpers (Pillars 1, 2, 3)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('city' in data) || data.city is string)
        && (!('niche' in data) || data.niche is string)
        && (!('googleMapsUrl' in data) || (data.googleMapsUrl is string && data.googleMapsUrl.size() <= 1024))
        && (!('nfcCustomUrl' in data) || (data.nfcCustomUrl is string && data.nfcCustomUrl.size() <= 1024))
        && (!('nfcPassword' in data) || (data.nfcPassword is string && data.nfcPassword.size() <= 64));
    }

    function isValidAcesso(data) {
      return data.leadId is string && data.leadId.size() > 0 && data.leadId.size() <= 128
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 60
        && (!('date' in data) || data.date is string)
        && (!('location' in data) || data.location is string);
    }

    // Leads collection: validate id, fields, and prevent arbitrary corruptions
    match /leads/{leadId} {
      allow read: if true;
      allow create, update: if isValidId(leadId) && isValidLead(incoming());
      allow delete: if isValidId(leadId);

      // Acessos subcollection for NFC and QR Code scan analytics
      match /acessos/{acessoId} {
        allow read: if true;
        allow create, update: if isValidId(acessoId) && isValidAcesso(incoming());
        allow delete: if false; // Audit logs are immutable
      }

      // Access logs subcollection
      match /access_logs/{logId} {
        allow read: if true;
        allow create, update: if isValidId(logId) && isValidAcesso(incoming());
        allow delete: if false;
      }
    }

    // Collection group rule for querying acessos across leads (read-only)
    match /{path=**}/acessos/{acessoId} {
      allow read: if true;
      allow write: if false;
    }

    // Top-level access logs collection
    match /lead_access_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAcesso(incoming());
      allow update, delete: if false;
    }

    function isValidSystemUser(data) {
      return data.username is string && data.username.size() >= 2 && data.username.size() <= 100
        && data.role is string && data.role in ['master', 'operator', 'support', 'client', 'seller', 'reseller', 'affiliate'];
    }

    function isValidLoginAttempt(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && (data.attempts is int || data.attempts is string)
        && data.lastAttemptAt is string;
    }

    // CyberShield: System Users (PBKDF2 credentials & allowedTabs RBAC)
    match /system_users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidSystemUser(incoming());
      allow delete: if isValidId(userId) && userId != 'master' && userId != 'mysis_26';
    }

    // CyberShield: Login Attempts & Brute Force Lockout state (3 attempts -> 2 min lock)
    match /login_attempts/{attemptId} {
      allow read: if true;
      allow create, update: if isValidId(attemptId) && isValidLoginAttempt(incoming());
      allow delete: if isValidId(attemptId);
    }

    function isValidSeller(data) {
      return data.username is string && data.username.size() >= 2 && data.username.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.role is string && data.role in ['seller', 'reseller', 'affiliate', 'client', 'operator'];
    }

    // Sellers & Resellers Collection (with allowedTabs and permissions)
    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update: if isValidId(sellerId) && isValidSeller(incoming());
      allow delete: if isValidId(sellerId);
    }
  }
}

